EMITLANE_DATABASE_URL=postgres://emitlane:emitlane@localhost:5432/emitlane?sslmode=disable
EMITLANE_KAFKA_BROKERS=localhost:19092
# Development only. Keep the production default (false) and provision topics explicitly.
EMITLANE_KAFKA_AUTO_CREATE_TOPICS=true
EMITLANE_HTTP_ADDR=:8080
EMITLANE_LOG_LEVEL=info

# v0.2 control/presence. PostgreSQL remains the durable source of truth.
EMITLANE_CONTROL_CHECK_INTERVAL=2s
EMITLANE_RELAY_HEARTBEAT_INTERVAL=10s
EMITLANE_RELAY_STALE_AFTER=30s

# Separate Admin API: disabled by default. A bearer token is mandatory for a
# wildcard or non-loopback bind. Payload exposure should normally remain off.
EMITLANE_ADMIN_ENABLED=false
EMITLANE_ADMIN_ADDR=127.0.0.1:8081
EMITLANE_ADMIN_TOKEN=
EMITLANE_ADMIN_EXPOSE_PAYLOAD=false
