EMITLANE_DATABASE_URL=postgres://emitlane:emitlane@localhost:5432/emitlane?sslmode=disable
EMITLANE_KAFKA_BROKERS=localhost:19092
# Development only. Keep the production default (false) and provision topics explicitly.
EMITLANE_KAFKA_AUTO_CREATE_TOPICS=true
# v0.7 development: verified TLS and optional SASL. See docs/KAFKA_SECURITY.md.
# EMITLANE_KAFKA_TLS_ENABLED=true
# EMITLANE_KAFKA_TLS_CA_FILE=/run/secrets/kafka-ca.pem
# Optional mTLS: provide both files together.
# EMITLANE_KAFKA_TLS_CERT_FILE=/run/secrets/kafka-client.pem
# EMITLANE_KAFKA_TLS_KEY_FILE=/run/secrets/kafka-client.key
# Normally omit SERVER_NAME so each discovered broker's own name is verified.
# EMITLANE_KAFKA_TLS_SERVER_NAME=kafka.example.internal
# Supported: PLAIN, SCRAM-SHA-256, SCRAM-SHA-512. All require TLS.
# EMITLANE_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# EMITLANE_KAFKA_SASL_USERNAME=emitlane
# Supply PASSWORD_FILE or PASSWORD, never both. Prefer a mounted secret file.
# EMITLANE_KAFKA_SASL_PASSWORD_FILE=/run/secrets/kafka-password
EMITLANE_HTTP_ADDR=:8080
EMITLANE_LOG_LEVEL=info

# v0.2 control/presence. PostgreSQL remains the durable source of truth.
EMITLANE_CONTROL_CHECK_INTERVAL=2s
EMITLANE_RELAY_HEARTBEAT_INTERVAL=10s
EMITLANE_RELAY_STALE_AFTER=30s

# v0.3 ordered virtual-partition ownership. The lease must exceed publish
# timeout + safety margin; the rebalance interval must be shorter than the lease.
EMITLANE_ORDERING_REBALANCE_INTERVAL=2s
EMITLANE_ORDERING_LEASE_DURATION=30s
EMITLANE_ORDERING_SAFETY_MARGIN=1s

# Separate Admin API: disabled by default. A bearer token is mandatory for a
# wildcard or non-loopback bind. Payload exposure should normally remain off.
EMITLANE_ADMIN_ENABLED=false
EMITLANE_ADMIN_ADDR=127.0.0.1:8081
EMITLANE_ADMIN_TOKEN=
EMITLANE_ADMIN_EXPOSE_PAYLOAD=false
